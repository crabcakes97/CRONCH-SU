<?xml version="1.0" encoding="utf-8"?>
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1000"
    android:interpolator="@android:interpolator/linear"
    android:valueType="floatType">
    <propertyValuesHolder android:propertyName="rotation">
        <keyframe android:fraction="0" android:value="0" />
        <keyframe android:fraction="0.25" android:value="0" />
        <keyframe android:fraction="0.32" android:value="-14" />
        <keyframe android:fraction="0.4" android:value="12" />
        <keyframe android:fraction="0.48" android:value="-12" />
        <keyframe android:fraction="0.56" android:value="10" />
        <keyframe android:fraction="0.64" android:value="-8" />
        <keyframe android:fraction="0.72" android:value="0" />
        <keyframe android:fraction="1" android:value="0" />
    </propertyValuesHolder>
</objectAnimator>
