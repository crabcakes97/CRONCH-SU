<?xml version="1.0" encoding="utf-8"?>
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="1000"
    android:interpolator="@android:interpolator/linear"
    android:valueType="floatType">
    <propertyValuesHolder android:propertyName="fillAlpha">
        <keyframe android:fraction="0" android:value="0" />
        <keyframe android:fraction="0.8" android:value="0" />
        <keyframe android:fraction="0.86" android:value="0.75" />
        <keyframe android:fraction="0.93" android:value="0.25" />
        <keyframe android:fraction="1" android:value="0" />
    </propertyValuesHolder>
</objectAnimator>
